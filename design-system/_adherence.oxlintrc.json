{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/navigation/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|DM Sans|Inter))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, DM Sans, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandWordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|showIcon|as|style|key|ref|className|style|children)$/]",
        "message": "<BrandWordmark> doesn't accept that prop. Declared props: size, showIcon, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandWordmark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:header|page|display|compact)$/]",
        "message": "<BrandWordmark> size must be one of 'header' | 'page' | 'display' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|interactive|noise|padding|radius|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: as, interactive, noise, padding, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DrinkChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:slug|children|style|key|ref|className|style|children)$/]",
        "message": "<DrinkChip> doesn't accept that prop. Declared props: slug, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DrinkChip'] > JSXAttribute[name.name='slug'] > Literal[value!=/^(?:guinness|guinness-00|beamish|murphys|other)$/]",
        "message": "<DrinkChip> slug must be one of 'guinness' | 'guinness-00' | 'beamish' | 'murphys' | 'other'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialRatingBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|size|style|key|ref|className|style|children)$/]",
        "message": "<EditorialRatingBlock> doesn't accept that prop. Declared props: score, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialRatingBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:feed|hero)$/]",
        "message": "<EditorialRatingBlock> size must be one of 'feed' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|fullWidth|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: icon, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|onAdd|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: active, onNavigate, onAdd."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:feed|find|profile)$/]",
        "message": "<NavBar> active must be one of 'feed' | 'find' | 'profile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingScore'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|size|showMax|style|key|ref|className|style|children)$/]",
        "message": "<RatingScore> doesn't accept that prop. Declared props: score, size, showMax, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingScore'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<RatingScore> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|count|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|pill|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, pill, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|cream|gold|sage|rust)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'cream' | 'gold' | 'sage' | 'rust'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
